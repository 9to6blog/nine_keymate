<Window x:Class="KeyMate.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KeyMate" Style="{StaticResource {x:Type Window}}" Width="1120" Height="870" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" Icon="Assets/keymate.ico" Closing="Window_Closing">
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,30,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="12,0,0,36"><Image Source="Assets/keymate.ico" Width="37" Height="37"/><StackPanel Margin="12,0,0,0"><TextBlock Text="KeyMate" FontSize="23" FontWeight="Bold"/><TextBlock Text="작은 입력, 더 큰 여유" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="1,2,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,12"/>
          <Button x:Name="EntriesNav" Style="{StaticResource NavButton}" Tag="entries" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="17" Margin="0,0,13,0"/><TextBlock Text="대치 항목"/></StackPanel></Button>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="settings" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="17" Margin="0,0,13,0"/><TextBlock Text="설정"/></StackPanel></Button>
          <Button x:Name="BackupNav" Style="{StaticResource NavButton}" Tag="backup" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE753;" FontSize="17" Margin="0,0,13,0"/><TextBlock Text="백업 및 복원"/></StackPanel></Button>
          <Button x:Name="AboutNav" Style="{StaticResource NavButton}" Tag="about" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" FontSize="17" Margin="0,0,13,0"/><TextBlock Text="정보"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="3"><Border Background="{DynamicResource SoftAccentBrush}" CornerRadius="10" Padding="15,18"><StackPanel><TextBlock Text="반복은 줄이고," FontWeight="SemiBold" FontSize="14"/><TextBlock Text="중요한 일에 집중하세요." FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0"/><TextBlock Text="자주 쓰는 문장을 짧은 단축어로." Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border><TextBlock Text="●  내 PC에만 안전하게 저장" Style="{StaticResource Muted}" FontSize="10" Margin="12,20,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="34,29,34,19">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,25"><Border DockPanel.Dock="Right" Background="{DynamicResource SoftAccentBrush}" CornerRadius="14" Padding="11,6"><TextBlock x:Name="EngineStatus" Text="●  자동 치환 켜짐" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Border><TextBlock Text="나의 텍스트 도우미" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/></DockPanel>
      <Grid Grid.Row="1">
        <Grid x:Name="EntriesPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="대치 항목" Style="{StaticResource PageTitle}"/><TextBlock Text="자주 쓰는 말은 저장하고, 필요한 순간 짧게 입력하세요." Style="{StaticResource Muted}" Margin="0,9,0,25"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Height="44" x:Name="SearchBox" TextChanged="Search_Changed" Padding="36,12,12,12" AutomationProperties.Name="단축어 또는 대치 문구 검색"/><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="SearchPlaceholder" Text="단축어 또는 대치 문구 검색..." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="37,0,0,0" IsHitTestVisible="False"/><Button Grid.Column="2" Content="＋  새 항목 추가" Style="{StaticResource PrimaryButton}" Click="Add_Click"/></Grid>
          <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="43"/></Grid.RowDefinitions>
            <Grid Background="{DynamicResource CanvasBrush}" Margin="1"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition/><ColumnDefinition Width="106"/><ColumnDefinition Width="62"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="단축어" Margin="22,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Grid.Column="1" Text="대치 문구" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Grid.Column="2" Text="설명" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Grid.Column="3" Text="사용" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11"/></Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SnippetList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" MinHeight="50"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition/><ColumnDefinition Width="106"/><ColumnDefinition Width="62"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="21,0,8,0"><TextBlock Text="{Binding Shortcut}" FontFamily="Cascadia Mono, Malgun Gothic" FontSize="12" MaxWidth="94" TextTrimming="CharacterEllipsis"/></Border><TextBlock Grid.Column="1" Text="{Binding Preview}" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Expansion}"/><TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" TextTrimming="CharacterEllipsis"/><CheckBox Grid.Column="3" IsChecked="{Binding Enabled, Mode=OneWay}" Style="{StaticResource Toggle}" HorizontalAlignment="Left" Click="Toggle_Click" AutomationProperties.Name="항목 사용 여부"/><Button Grid.Column="4" Content="⋯" Padding="0" Margin="0,10,9,10" Height="24" BorderThickness="0" Background="Transparent" FontSize="22" Click="More_Click" ToolTip="수정 또는 삭제"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <TextBlock x:Name="EmptyState" Grid.Row="1" Text="검색 결과가 없습니다. 다른 단어를 입력해 보세요." HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" Visibility="Collapsed"/>
            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="20,0"><TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="Space로 간편하게 치환" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel></Border>
          </Grid></Border>
          <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="19,12"><StackPanel><DockPanel><TextBlock Text="바로 연습해 보세요" FontWeight="SemiBold"/><TextBlock Text="ㅈㅅ + Space" Foreground="{DynamicResource AccentBrush}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><TextBox x:Name="Playground" Margin="0,12,0,0" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap" KeyUp="Playground_KeyUp" AutomationProperties.Name="단축어 연습 입력창"/><TextBlock Text="등록한 단축어 뒤에 Space를 누르면 문구로 바뀝니다." Style="{StaticResource Muted}" FontSize="10" Margin="0,9,0,0"/></StackPanel></Border>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="설정" Style="{StaticResource PageTitle}"/><TextBlock Text="나에게 맞는 입력 환경을 만들어 보세요." Style="{StaticResource Muted}" Margin="0,9,0,25"/>
          <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="일반" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <DockPanel Margin="0,8"><CheckBox x:Name="EnabledSetting" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Settings_Click"/><StackPanel><TextBlock Text="자동 치환 사용"/><TextBlock Text="트레이 메뉴에서 잠시 멈출 수도 있어요." Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DockPanel>
            <DockPanel Margin="0,16,0,6"><CheckBox x:Name="StartupSetting" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Settings_Click"/><StackPanel><TextBlock Text="Windows 시작 시 자동 실행"/><TextBlock Text="로그인하면 트레이에서 조용히 시작합니다." Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DockPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0"><StackPanel><TextBlock Text="치환 키" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/><DockPanel Margin="0,6"><CheckBox x:Name="SpaceSetting" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Settings_Click"/><TextBlock Text="Space  ·  한글 / 영문 (권장)"/></DockPanel><DockPanel Margin="0,17,0,6"><CheckBox x:Name="EnterSetting" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Settings_Click"/><TextBlock Text="Enter  ·  영문 키보드의 영문 단축어"/></DockPanel><DockPanel Margin="0,17,0,6"><CheckBox x:Name="TabSetting" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Settings_Click"/><TextBlock Text="Tab  ·  영문 키보드의 영문 단축어"/></DockPanel><TextBlock Text="Enter·Tab 치환에 성공하면 문구만 확정합니다. 전송이나 포커스 이동은 키를 한 번 더 누르세요." TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,15,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0"><StackPanel><TextBlock Text="제외할 앱" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="실행 파일 이름을 세미콜론으로 구분하세요. 예: game.exe; app.exe" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,12"/><TextBox x:Name="ExcludedSetting" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" LostFocus="Excluded_LostFocus"/><TextBlock Text="테마" Margin="0,19,0,10"/><ComboBox x:Name="ThemeSetting" Padding="9" SelectionChanged="Theme_Changed"><ComboBoxItem Content="시스템 설정과 동일하게" Tag="System"/><ComboBoxItem Content="라이트" Tag="Light"/><ComboBoxItem Content="다크" Tag="Dark"/></ComboBox></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <StackPanel x:Name="BackupPage" Visibility="Collapsed"><TextBlock Text="백업 및 복원" Style="{StaticResource PageTitle}"/><TextBlock Text="소중한 문구를 파일로 보관하고, 다른 PC로 옮겨 보세요." Style="{StaticResource Muted}" Margin="0,9,0,25"/>
          <Border Style="{StaticResource Card}" Padding="26"><StackPanel><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" Foreground="{DynamicResource AccentBrush}" FontSize="26"/><TextBlock Text="내보내기" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,9"/><TextBlock Text="모든 대치 항목을 JSON 파일로 저장합니다." Style="{StaticResource Muted}"/><Button Content="백업 파일 저장" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="Export_Click"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="26" Margin="0,18,0,0"><StackPanel><TextBlock Text="가져오기" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="같은 단축어는 백업 내용으로 갱신하고, 새로운 항목은 추가합니다.&#x0a;현재 PC에만 있는 항목은 유지됩니다." TextWrapping="Wrap" Style="{StaticResource Muted}" LineHeight="23" Margin="0,10,0,20"/><Button Content="JSON 파일 선택" HorizontalAlignment="Left" Click="Import_Click"/></StackPanel></Border>
          <TextBlock Text="백업에는 대치 문구가 그대로 포함됩니다. 파일을 보관할 위치를 확인해 주세요.&#x0a;이 버전은 수동 파일 백업을 지원합니다." TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,21,0,0" LineHeight="21"/>
        </StackPanel>
        <StackPanel x:Name="AboutPage" Visibility="Collapsed"><Image Source="Assets/keymate.ico" Width="72" Height="72" HorizontalAlignment="Left" Margin="0,4,0,22"/><TextBlock Text="자주 쓰는 말을, 더 빠르게." Style="{StaticResource PageTitle}"/><TextBlock Text="KeyMate  0.1.0  ·  Windows 네이티브" Style="{StaticResource Muted}" Margin="0,12,0,28"/>
          <Border Style="{StaticResource Card}" Padding="24"><StackPanel><TextBlock Text="작은 입력이 만드는 큰 변화" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="한글은 Space로 조합이 끝난 뒤, 입력창의 실제 텍스트를 확인해 치환합니다. 날짜는 {date}, 시간은 {time}으로 넣을 수 있습니다." TextWrapping="Wrap" LineHeight="24" Margin="0,15,0,18"/><TextBlock Text="지원 범위" FontWeight="SemiBold"/><TextBlock Text="접근성 텍스트를 제공하는 편집창에서 동작합니다. 비밀번호·읽기 전용 입력창은 건너뜁니다. 관리자 권한 앱, 터미널, 게임, 일부 편집기는 지원되지 않을 수 있습니다." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="23" Margin="0,9,0,18"/><TextBlock Text="내 PC에 저장" FontWeight="SemiBold"/><TextBlock Text="문구는 %LOCALAPPDATA%\KeyMate\keymate.db에 저장됩니다. 입력 기록과 클립보드를 저장하지 않으며 서버로 전송하지 않습니다." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="23" Margin="0,9,0,0"/></StackPanel></Border>
        </StackPanel>
      </Grid>
      <TextBlock Grid.Row="2" x:Name="StatusText" Text="준비되었습니다. 창을 닫아도 트레이에서 계속 실행됩니다." Style="{StaticResource Muted}" FontSize="10" Margin="0,19,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
