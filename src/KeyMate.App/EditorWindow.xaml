<Window x:Class="KeyMate.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="새 대치 항목" Width="476" Height="650" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}" Icon="Assets/keymate.ico">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="Heading" Text="새 대치 항목" FontSize="24" FontWeight="Bold"/><TextBlock Text="자주 쓰는 문장에 짧은 이름을 붙여 주세요." Style="{StaticResource Muted}" Margin="0,8,0,27"/>
      <TextBlock Text="단축어 *" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBox x:Name="ShortcutBox" MaxLength="64" AutomationProperties.Name="단축어"/>
      <TextBlock Text="대치 문구 *" FontWeight="SemiBold" Margin="0,22,0,9"/><TextBox x:Name="ExpansionBox" Height="126" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" AutomationProperties.Name="대치 문구"/>
      <TextBlock Text="{}{date} 오늘 날짜   ·   {time} 현재 시간" Style="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0"/>
      <TextBlock Text="설명 (선택)" FontWeight="SemiBold" Margin="0,20,0,9"/><TextBox x:Name="DescriptionBox" MaxLength="80" AutomationProperties.Name="설명"/>
      <CheckBox x:Name="CaseBox" Content="대소문자 구분" Margin="0,22,0,6"/><CheckBox x:Name="BoundaryBox" Content="단어 경계에서만 치환 (권장)" IsChecked="True"/>
      <TextBlock x:Name="ErrorText" Foreground="#D84949" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" Width="90" Margin="0,0,10,0" IsCancel="True"/><Button Content="저장" Width="100" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
